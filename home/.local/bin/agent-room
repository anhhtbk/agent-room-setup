#!/usr/bin/env python3
"""Launch Claude Code, oh-my-pi, or Pi (pi.dev) as a Room role.

Paseo starts a derived provider as ``agent-room <runtime> <role> <provider args...>``.
The role contract is the ``developer_instructions`` block of the same overlay
used by ``codex-room``, so every runtime reads one source of role authority.

Unlike Codex, these runtimes keep the operator's home and login.
Role policy is applied per process instead:

* Claude Code: a ``SessionStart`` hook (merged into any host ``--settings``)
  injects the role on startup, resume, clear, and compaction. The Agent SDK
  delivers its own system-prompt append over the control channel, which
  replaces an argv ``--append-system-prompt``, so argv cannot carry the role.
* omp: the role is merged into ``--append-system-prompt`` (last value wins, so
  the host's value is folded in rather than overridden).
* Pi: a separate additive ``--append-system-prompt`` supplies the role while
  Pi retains ownership of parsing host appends, files, and positional messages.
  Pi has no built-in subagent tool. Operator extensions remain operator-owned.
  A Room extension translates Paseo's session MCP config into native Pi MCP and
  stops a Paseo Supervisor/Lead session that arrives without Paseo tools.
* Native subagents are disabled (Claude ``Agent``/``Workflow`` tools; omp ``task``
  tool via a config overlay) so delegation goes through Paseo roles.
* Supervisor does not edit project files: a Claude ``PreToolUse`` hook denies
  ``Edit``/``Write``/``NotebookEdit`` outside its auto-memory
  (``~/.claude/projects/*/memory/``), and an omp extension blocks omp's
  file-changing tools. Shell writes are not covered.

Probe and subcommand invocations (``--version``, ``auth status``, ...) run
unchanged.
"""

import json
import os
import pathlib
import re
import shlex
import shutil
import subprocess
import sys

REEXEC_TRIED = "CODEX_ROOM_PYTHON_TRIED"

try:
    import tomllib
except ModuleNotFoundError:
    # Paseo runs this launcher with the daemon PATH, where ``python3`` can be a
    # pre-3.11 system interpreter (macOS /usr/bin/python3 is 3.9). A versioned
    # name can also resolve to an old interpreter, so each one is tried at most
    # once across re-execs.
    tried = set(filter(None, os.environ.get(REEXEC_TRIED, "").split(os.pathsep)))
    tried.add(os.path.realpath(sys.executable))
    for candidate in ("python3.14", "python3.13", "python3.12", "python3.11"):
        interpreter = shutil.which(candidate)
        if interpreter and os.path.realpath(interpreter) not in tried:
            tried.add(os.path.realpath(interpreter))
            os.environ[REEXEC_TRIED] = os.pathsep.join(sorted(tried))
            os.execv(interpreter, [interpreter, *sys.argv])
    raise SystemExit("agent-room requires Python 3.11+ (tomllib); none found on PATH")
os.environ.pop(REEXEC_TRIED, None)


RUNTIMES = ("claude", "omp", "pi")
ROLES = ("supervisor", "lead", "peer")
SESSION_START_MODE = "--claude-session-start"
PRE_TOOL_USE_MODE = "--claude-pre-tool-use"
APPEND_FLAG = "--append-system-prompt"
SETTINGS_FLAG = "--settings"
CLAUDE_DISALLOWED_FLAGS = ("--disallowedTools", "--disallowed-tools")
# Agent spawns subagents; Workflow fans out background agents.
CLAUDE_SUBAGENT_TOOLS = ("Agent", "Workflow")
# Claude file-editing tools the Supervisor guard applies to (MultiEdit in older releases).
CLAUDE_FILE_TOOLS = ("Edit", "MultiEdit", "Write", "NotebookEdit")
SUPERVISOR_EDIT_DENIAL = (
    "Room Supervisor does not edit project files or Claude configuration; only its "
    "auto-memory under ~/.claude/projects/*/memory/ is writable. Route this change to "
    "the project's Lead (send it to the Lead agent) instead of making it yourself."
)
OMP_OVERLAY = "omp-room.config.yml"
OMP_SUPERVISOR_GUARD = "omp-supervisor-guard.mjs"
PROBE_ARGS = {"--version", "-v", "-V", "--help", "-h"}
PI_SUBCOMMANDS = {"install", "remove", "uninstall", "update", "list", "config", "auth", "mcp"}
USAGE = f"usage: agent-room <{'|'.join(RUNTIMES)}> <{'|'.join(ROLES)}> [runtime args...]"


def require_pi_version(binary: str) -> None:
    """Check before extension loading, which older Pi releases may not support."""
    try:
        result = subprocess.run(
            [binary, "--version"], capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        raise SystemExit("cannot determine Pi version; Room sessions require Pi 1.3.0 or newer")
    version = re.fullmatch(r"(\d+)\.(\d+)\.(\d+)(?:\+[^\s]+)?", result.stdout.strip())
    if result.returncode or not version or tuple(map(int, version.groups())) < (1, 3, 0):
        raise SystemExit("Room Pi sessions require stable Pi 1.3.0 or newer; update Pi or set PI_BIN")


def room_config_home() -> pathlib.Path:
    configured = os.environ.get("CODEX_ROOM_CONFIG_HOME")
    if configured:
        return pathlib.Path(configured).expanduser()
    return pathlib.Path.home() / ".config" / "codex-room"


def role_instructions(role: str) -> str:
    overlay = room_config_home() / "overlays" / f"{role}.config.toml"
    try:
        with overlay.open("rb") as stream:
            document = tomllib.load(stream)
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise SystemExit(f"cannot read role overlay {overlay}: {error}")
    instructions = document.get("developer_instructions")
    if not isinstance(instructions, str) or not instructions.strip():
        raise SystemExit(f"role overlay has no developer_instructions: {overlay}")
    return instructions.strip()


def local_contract_note(cwd: str | None = None) -> str:
    """State whether the launch project has a local contract, so no agent probes for it."""
    start = pathlib.Path(cwd or os.getcwd())
    top = start
    try:
        result = subprocess.run(
            ["git", "-C", str(start), "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, timeout=10,
        )
        if result.returncode == 0 and result.stdout.strip():
            top = pathlib.Path(result.stdout.strip())
    except (OSError, subprocess.SubprocessError):
        pass
    local = top / "docs" / "WORKSPACE_PROTOCOL.md"
    state = "present; read it" if local.is_file() else "absent"
    return (f"Launch project `{top}`: `docs/WORKSPACE_PROTOCOL.md` is {state}. "
            "Look for a local contract again only in a different target project.")


def role_prompt(role: str, cwd: str | None = None) -> str:
    return f"{role_instructions(role)}\n\n{local_contract_note(cwd)}"


def is_session(args: list[str]) -> bool:
    """Sessions start with no args or a flag; probes and subcommands do not."""
    if not args:
        return True
    return args[0].startswith("-") and args[0] not in PROBE_ARGS


def take_flag(args: list[str], names: tuple[str, ...]) -> tuple[list[str], list[str]]:
    """Remove every ``--name value`` / ``--name=value`` and return (rest, values)."""
    rest: list[str] = []
    values: list[str] = []
    index = 0
    while index < len(args):
        arg = args[index]
        name, separator, inline = arg.partition("=")
        if name in names and separator:
            values.append(inline)
        elif arg in names:
            if index + 1 >= len(args):
                raise SystemExit(f"{arg} requires a value")
            values.append(args[index + 1])
            index += 1
        else:
            rest.append(arg)
        index += 1
    return rest, values


def host_settings(values: list[str]) -> dict:
    """Load the last host ``--settings`` value (inline JSON or a file path)."""
    if not values:
        return {}
    value = values[-1]
    text = value if value.lstrip().startswith("{") else pathlib.Path(value).read_text()
    settings = json.loads(text)
    if not isinstance(settings, dict):
        raise SystemExit("--settings must be a JSON object")
    return settings


def claude_args(args: list[str], role: str) -> list[str]:
    role_instructions(role)  # fail before exec when the role contract is unreadable
    args, settings_values = take_flag(args, (SETTINGS_FLAG,))
    settings = host_settings(settings_values)
    hook = shlex.join([str(pathlib.Path(__file__).resolve()), SESSION_START_MODE, role])
    hooks = settings.setdefault("hooks", {})
    hooks.setdefault("SessionStart", []).append({"hooks": [{"type": "command", "command": hook}]})
    if role == "supervisor":
        guard = shlex.join([str(pathlib.Path(__file__).resolve()), PRE_TOOL_USE_MODE, role])
        hooks.setdefault("PreToolUse", []).append({
            "matcher": "|".join(CLAUDE_FILE_TOOLS),
            "hooks": [{"type": "command", "command": guard}],
        })

    args, denied = take_flag(args, CLAUDE_DISALLOWED_FLAGS)
    tools = [tool for value in denied for tool in value.split(",") if tool]
    tools += [tool for tool in CLAUDE_SUBAGENT_TOOLS if tool not in tools]
    return [
        SETTINGS_FLAG, json.dumps(settings, separators=(",", ":")),
        CLAUDE_DISALLOWED_FLAGS[0], ",".join(tools),
        *args,
    ]


def omp_args(args: list[str], role: str) -> list[str]:
    overlay = room_config_home() / OMP_OVERLAY
    if not overlay.is_file():
        raise SystemExit(f"omp room overlay is missing: {overlay}")
    role_text = role_prompt(role)
    args, prompts = take_flag(args, (APPEND_FLAG,))
    prompt = role_text
    if prompts:
        # omp accepts text or a file path here; resolve before merging.
        host = prompts[-1]
        if os.path.isfile(host):
            host = pathlib.Path(host).read_text()
        if host.strip():
            prompt = f"{role_text}\n\n{host}"
    extra = []
    if role == "supervisor":
        guard = room_config_home() / OMP_SUPERVISOR_GUARD
        if not guard.is_file():
            raise SystemExit(f"omp Supervisor guard is missing: {guard}")
        extra = ["--extension", str(guard)]
    return ["--config", str(overlay), *extra, APPEND_FLAG, prompt, *args]


def claude_session_start(role: str) -> None:
    """Claude Code SessionStart hook: emit the role as session context."""
    try:
        cwd = json.loads(sys.stdin.read() or "{}").get("cwd")
    except (json.JSONDecodeError, AttributeError):
        cwd = None
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": role_prompt(role, cwd if isinstance(cwd, str) else None),
        }
    }))


def supervisor_edit_denial(event: object) -> str | None:
    """Why a Supervisor file edit is denied, or None for its auto-memory."""
    if not isinstance(event, dict) or not isinstance(event.get("tool_input"), dict):
        return SUPERVISOR_EDIT_DENIAL
    tool_input = event["tool_input"]
    target = tool_input.get("file_path") or tool_input.get("notebook_path")
    if not isinstance(target, str) or not target:
        return SUPERVISOR_EDIT_DENIAL
    cwd = event.get("cwd") if isinstance(event.get("cwd"), str) else os.getcwd()
    # realpath follows symlinks, so a link inside memory/ cannot reach other files.
    resolved = pathlib.Path(os.path.realpath(os.path.join(cwd, os.path.expanduser(target))))
    projects = pathlib.Path(os.path.realpath(pathlib.Path.home() / ".claude" / "projects"))
    if resolved.is_relative_to(projects):
        # <project slug>/memory/<file...>
        parts = resolved.relative_to(projects).parts
        if len(parts) >= 3 and parts[1] == "memory":
            return None
    return SUPERVISOR_EDIT_DENIAL


def claude_pre_tool_use() -> None:
    """Claude Code PreToolUse hook for the Supervisor: deny edits outside auto-memory.

    A hook that errors lets the tool run, so every failure here denies."""
    try:
        reason = supervisor_edit_denial(json.loads(sys.stdin.read() or "{}"))
    except Exception:  # fail closed
        reason = SUPERVISOR_EDIT_DENIAL
    if reason is None:
        return
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        }
    }))


def main() -> None:
    if len(sys.argv) < 3:
        raise SystemExit(USAGE)
    first, role, args = sys.argv[1], sys.argv[2], sys.argv[3:]
    if role not in ROLES:
        raise SystemExit(f"unknown role: {role}\n{USAGE}")
    if first == SESSION_START_MODE and not args:
        claude_session_start(role)
        return
    if first == PRE_TOOL_USE_MODE and not args:
        claude_pre_tool_use()
        return
    if first not in RUNTIMES:
        raise SystemExit(f"unknown runtime: {first}\n{USAGE}")

    env_name = {"claude": "CLAUDE_BIN", "omp": "OMP_BIN", "pi": "PI_BIN"}[first]
    binary = os.environ.get(env_name) or shutil.which(first)
    if not binary:
        raise SystemExit(f"{first} not found; install it or set {env_name}")

    if first == "pi":
        if not args or args[0] not in PROBE_ARGS | PI_SUBCOMMANDS:
            role_text = role_prompt(role)
            adapter = room_config_home() / "pi-mcp-adapter.mjs"
            if not adapter.is_file():
                raise SystemExit(f"Pi room MCP adapter is missing: {adapter}")
            require_pi_version(binary)
            args = [
                APPEND_FLAG, role_text,
                "--extension", str(adapter), *args,
            ]
            os.environ["AGENT_ROOM_ROLE"] = role
    elif is_session(args):
        args = claude_args(args, role) if first == "claude" else omp_args(args, role)
    os.execv(binary, [binary, *args])


if __name__ == "__main__":
    main()
