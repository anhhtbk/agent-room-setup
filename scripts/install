#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

apply=false
for argument in "$@"; do
  case "$argument" in
    --apply) apply=true ;;
    --dry-run) apply=false ;;
    -h|--help)
      cat <<'EOF'
Usage: scripts/install [--dry-run|--apply]

Dry-run is the default. --apply backs up replaced files and installs the
tracked HOME mirror. The script never writes to ~/.codex or ~/.codex-runtime.
EOF
      exit 0
      ;;
    *) die "unknown argument: $argument" ;;
  esac
done

require_command python3

timestamp=$(date -u +%Y%m%dT%H%M%SZ)
backup_root="$HOME/.codex-room-backups/install-${timestamp}"
changed=0

install_one() {
  local relative_source="$1"
  local relative_target="$2"
  local mode="$3"
  local source_path="$REPO_ROOT/home/$relative_source"
  local target_path="$HOME/$relative_target"
  local temporary

  [[ -f "$source_path" ]] || die "source file is missing: $source_path"
  temporary=$(mktemp "${TMPDIR:-/tmp}/codex-room-install.XXXXXX")
  render_home_tokens "$source_path" "$temporary"

  if [[ -f "$target_path" ]] && cmp -s "$temporary" "$target_path"; then
    log "UNCHANGED  ~/$relative_target"
    rm -f "$temporary"
    return
  fi

  changed=$((changed + 1))
  if [[ "$apply" != true ]]; then
    if [[ -e "$target_path" || -L "$target_path" ]]; then
      log "REPLACE    ~/$relative_target"
    else
      log "CREATE     ~/$relative_target"
    fi
    rm -f "$temporary"
    return
  fi

  if [[ -e "$target_path" || -L "$target_path" ]]; then
    local backup_path="$backup_root/$relative_target"
    mkdir -p "$(dirname "$backup_path")"
    cp -p "$target_path" "$backup_path"
  fi

  mkdir -p "$(dirname "$target_path")"
  install -m "$mode" "$temporary" "$target_path"
  rm -f "$temporary"
  log "INSTALLED  ~/$relative_target"
}

retire_obsolete() {
  local relative_target="$1"
  local target_path="$HOME/$relative_target"
  [[ -e "$target_path" || -L "$target_path" ]] || return 0
  changed=$((changed + 1))
  if [[ "$apply" != true ]]; then
    log "RETIRE     ~/$relative_target"
    return
  fi
  local backup_path="$backup_root/$relative_target"
  mkdir -p "$(dirname "$backup_path")"
  cp -Pp "$target_path" "$backup_path"
  rm -f "$target_path"
  log "RETIRED    ~/$relative_target"
}

# spec-orchestration files are retired only when their bytes match a version
# this repository or this cutover published; customized copies are kept.
SPEC_ORCHESTRATION_DIGESTS="
db02670871fd7a8a59bc6d9acfbbb1e2284c6c159792b16308a286b39ca162b3
723e0e0d83cb50913680e7f298b32b27002c2f88b367a9e34a3e9926675f7bda
af6609862fe97acd46379dbe6fcf75b7f32f7f611a9cfe5485891adfae236ab9
399f25233e51dcf60c9fc5ced9f3c4ad606e56c6f5535b2abf332c59ab727577
59f874b00ef3a13355e1be5ef8d6cf52904b78ae73aabd0201ffb9727a26c402
b5c66787efca419b3ebcb48303be70b0bd86a9e64ed9f95f0f5150650a9a63d1
4a55915566396f96c4ade637e1e695725aaad74da0f34997b9c03933dab65321
b60d355e823a55e80b131648a6b8035c4353e43e42efbb47f2613e5f6e566483
418064ff2e7c004c322fc1853b3fbed4094011f2dd57ca108d0841f1917a5a26
5e2447affbbbbc43137d37b7d9a2d2382cb4b6e0ca1d7d5eb17ccd50552b61b5
42083c1bd80fb2a445df29daf513fdc24de9539f59f24a12e71e81b59595b626
2b2d88f3bf24a0f422c69b9331a496fb92e4fef1c4c31e27bbdbdf75775f3dbd
5a6b1e94294ceeaa201f3de6b0ff608fe0ad253922b153fdfb4d02b37cdd2149
"

retire_known() {
  local relative_target="$1"
  local target_path="$HOME/$relative_target"
  [[ -e "$target_path" || -L "$target_path" ]] || return 0
  if [[ -L "$target_path" || ! -f "$target_path" ]] ||
    ! grep -Fqx "$(sha256_file "$target_path")" <<<"$SPEC_ORCHESTRATION_DIGESTS"; then
    log "PRESERVE   ~/$relative_target (customized; not a known published version)"
    return
  fi
  retire_obsolete "$relative_target"
}

while IFS='|' read -r source target mode; do
  [[ -n "$source" ]] || continue
  install_one "$source" "$target" "$mode"
done <<'EOF'
.config/codex-room/model-instructions.md|.config/codex-room/model-instructions.md|644
.config/codex-room/overlays/supervisor.config.toml|.config/codex-room/overlays/supervisor.config.toml|600
.config/codex-room/overlays/lead.config.toml|.config/codex-room/overlays/lead.config.toml|600
.config/codex-room/overlays/peer.config.toml|.config/codex-room/overlays/peer.config.toml|600
.config/codex-room/workflow/WORKSPACE_PROTOCOL.md|.config/codex-room/workflow/WORKSPACE_PROTOCOL.md|644
.config/codex-room/omp-room.config.yml|.config/codex-room/omp-room.config.yml|644
.config/codex-room/workflow/IMPLEMENT_SPEC.md|.config/codex-room/workflow/IMPLEMENT_SPEC.md|644
.config/codex-room/tools/tree-audit.py|.config/codex-room/tools/tree-audit.py|755
.config/codex-room/tools/worktree-guard.py|.config/codex-room/tools/worktree-guard.py|755
.config/codex-room/tools/run-procs.py|.config/codex-room/tools/run-procs.py|755
.local/bin/codex-room|.local/bin/codex-room|755
.local/bin/codex-room-sync|.local/bin/codex-room-sync|755
.local/bin/agent-room|.local/bin/agent-room|755
.local/bin/paseo-local-update|.local/bin/paseo-local-update|755
.paseo/config.json.template|.paseo/config.json|600
EOF

# These retired entrypoints would keep removed roles addressable after an
# upgrade. Back them up and retire them without touching role runtimes or
# private workflow files.
for obsolete in \
  .config/codex-room/overlays/review.config.toml \
  .config/codex-room/overlays/harness.config.toml \
  .config/codex-room/paseo.phase2-coexist.candidate.json \
  .config/codex-room/paseo.phase2-hard-cut.candidate.json \
  .local/bin/codex-room-hard-cut \
  .local/bin/codex-review-apply; do
  retire_obsolete "$obsolete"
done
for name in SKILL.md reference.md questions.md brief-template.md scripts/frontier.py \
  scripts/ticket-field.py scripts/tree-audit.py scripts/worktree-guard.py scripts/run-procs.py; do
  retire_known ".config/codex-room/skills/spec-orchestration/$name"
done

if [[ "$apply" != true ]]; then
  log ""
  log "DRY_RUN: $changed file(s) would change. Run scripts/install --apply to install."
  exit 0
fi

if [[ -d "$backup_root" ]]; then
  chmod -R go-rwx "$backup_root"
  log "BACKUP     $backup_root"
fi
log "INSTALL_COMPLETE: $changed file(s) changed"
log "Next: scripts/sync-all"
