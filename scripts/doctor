#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

failures=0
warnings=0

check_command() {
  local command_name="$1"
  if command -v "$command_name" >/dev/null 2>&1; then
    printf 'OK    %-12s %s\n' "$command_name" "$(command -v "$command_name")"
  else
    printf 'FAIL  %-12s missing\n' "$command_name"
    failures=$((failures + 1))
  fi
}

for command_name in python3 git jq node npm; do
  check_command "$command_name"
done

if command -v "${CODEX_BIN:-codex}" >/dev/null 2>&1; then
expected_codex_version=$(awk -F'"' '/^codex_cli = / {print $2}' "$REPO_ROOT/paseo/versions.toml")
actual_codex_version=$("${CODEX_BIN:-codex}" --version 2>/dev/null | awk '{print $2}' || true)
if [[ "$actual_codex_version" == "$expected_codex_version" ]]; then
  log "OK    Codex CLI    $actual_codex_version"
else
  log "WARN  Codex CLI    expected $expected_codex_version; found ${actual_codex_version:-unknown}"
  warnings=$((warnings + 1))
fi
else
  log "WARN  Codex CLI    optional; missing runtime will not block setup"
  warnings=$((warnings + 1))
fi

if [[ -d "$HOME/.codex" ]]; then
  log "OK    Codex home   $HOME/.codex"
else
  log "WARN  Codex home   optional; $HOME/.codex is missing"
  warnings=$((warnings + 1))
fi

for resource in config.toml auth.json AGENTS.md skills plugins; do
  if [[ -e "$HOME/.codex/$resource" ]]; then
    log "OK    shared       ~/.codex/$resource"
  else
    log "WARN  shared       ~/.codex/$resource is missing; setup skips Codex runtime generation"
    warnings=$((warnings + 1))
  fi
done

# Agent runtimes are optional: their Room providers stay unavailable until installed.
for runtime_spec in claude:CLAUDE_BIN omp:OMP_BIN pi:PI_BIN; do
  IFS=: read -r command_name variable <<<"$runtime_spec"
  binary="${!variable:-$command_name}"
  if command -v "$binary" >/dev/null 2>&1; then
    version=$("$binary" --version 2>/dev/null) || version=""
    version=${version%%$'\n'*}
    if [[ -z "$version" ]]; then
      log "WARN  $(printf '%-12s' "$command_name") unable to read runtime version"
      warnings=$((warnings + 1))
    elif [[ "$command_name" == pi ]] && ! {
      [[ "$version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)(\+[^[:space:]]+)?$ ]] &&
        (( BASH_REMATCH[1] > 1 || (BASH_REMATCH[1] == 1 && BASH_REMATCH[2] >= 3) ))
    }; then
      log "WARN  Pi runtime   Room MCP requires Pi >=1.3.0; found ${version:-unknown}; setup remains available"
      warnings=$((warnings + 1))
    else
      log "OK    $(printf '%-12s' "$command_name") ${version:-unknown}"
    fi
  else
    log "WARN  $(printf '%-12s' "$command_name") missing; $command_name-* Room providers stay unavailable"
    warnings=$((warnings + 1))
  fi
done

case ":$PATH:" in
  *":$HOME/.local/bin:"*) log "OK    PATH         ~/.local/bin" ;;
  *)
    log "WARN  PATH         add ~/.local/bin before running Paseo"
    warnings=$((warnings + 1))
    ;;
esac

paseo_checkout="${PASEO_REPO_DIR:-$HOME/projects/supervisors/paseo}"
if [[ -d "$paseo_checkout/.git" ]]; then
  log "OK    Paseo release   $paseo_checkout"
  paseo_branch=$(awk -F'"' '/^branch = / {print $2; exit}' "$REPO_ROOT/paseo/source.toml")
  paseo_commit=$(awk -F'"' '/^verified_commit = / {print $2}' "$REPO_ROOT/paseo/source.toml")
  paseo_source=$(awk -F'"' '/^url = / {print $2}' "$REPO_ROOT/paseo/source.toml")
  paseo_tag=$(awk -F'"' '/^release_tag = / {print $2; exit}' "$REPO_ROOT/paseo/source.toml")
  actual_tag_commit=$(git -C "$paseo_checkout" rev-parse "refs/tags/$paseo_tag^{commit}" 2>/dev/null || true)
  actual_branch=$(git -C "$paseo_checkout" branch --show-current)
  actual_commit=$(git -C "$paseo_checkout" rev-parse HEAD)
  actual_origin=$(git -C "$paseo_checkout" remote get-url origin 2>/dev/null || true)
  tracking_remote=$(git -C "$paseo_checkout" config --get "branch.$paseo_branch.remote" || true)
  tracking_merge=$(git -C "$paseo_checkout" config --get "branch.$paseo_branch.merge" || true)
  remote_names=$(git -C "$paseo_checkout" remote | LC_ALL=C sort | tr '\n' ' ')

  for check_pair in \
    "branch|$paseo_branch|$actual_branch" \
    "commit|$paseo_commit|$actual_commit" \
    "release-tag|$paseo_commit|$actual_tag_commit" \
    "origin|$paseo_source|$actual_origin" \
    "tracking|origin|$tracking_remote" \
    "tracking-ref|refs/heads/$paseo_branch|$tracking_merge" \
    "remote-set|origin |$remote_names"; do
    IFS='|' read -r label expected actual <<<"$check_pair"
    if [[ "$actual" == "$expected" ]]; then
      log "OK    Paseo $label  $actual"
    else
      log "WARN  Paseo $label  expected $expected; found ${actual:-missing}"
      warnings=$((warnings + 1))
    fi
  done
else
  log "WARN  Paseo release   not found at $paseo_checkout"
  warnings=$((warnings + 1))
fi

# Room run directories: disk use of rebuildable caches. Extra roots (spec
# folders outside ~/.local/state) come from CODEX_ROOM_RUN_ROOTS, colon-separated.
IFS=':' read -r -a run_roots <<<"${CODEX_ROOM_RUN_ROOTS:-}"
while IFS= read -r line; do
  log "INFO  $line"
done < <(python3 "$REPO_ROOT/home/.config/codex-room/tools/room-gc.py" report \
  "$HOME/.local/state/codex-room/runs" ${run_roots[@]+"${run_roots[@]}"} 2>&1 | grep -E '^(RUN|MISSING|NO-RUNS)' || true)

log ""
if [[ "$failures" -gt 0 ]]; then
  die "$failures required check(s) failed; $warnings warning(s)"
fi
log "DOCTOR_OK: $warnings warning(s)"
