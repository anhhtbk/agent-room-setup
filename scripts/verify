#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

mode=installed
live=false
for argument in "$@"; do
  case "$argument" in
    --source) mode=source ;;
    --live) live=true ;;
    -h|--help) echo "Usage: scripts/verify [--source] [--live]"; exit 0 ;;
    *) die "unknown argument: $argument" ;;
  esac
done

require_command python3
require_command jq
[[ "$mode" == source ]] || require_command codex

failures=0
check() {
  local description="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    log "OK    $description"
  else
    log "FAIL  $description"
    failures=$((failures + 1))
  fi
}

if [[ "$mode" == source ]]; then
  config_template="$REPO_ROOT/home/.paseo/config.json.template"
  overlays_root="$REPO_ROOT/home/.config/codex-room/overlays"
  workflow_root="$REPO_ROOT/home/.config/codex-room/workflow"
  sync_path="$REPO_ROOT/home/.local/bin/codex-room-sync"
  launcher_path="$REPO_ROOT/home/.local/bin/codex-room"
  agent_launcher_path="$REPO_ROOT/home/.local/bin/agent-room"
  omp_overlay_path="$REPO_ROOT/home/.config/codex-room/omp-room.config.yml"
  tools_root="$REPO_ROOT/home/.config/codex-room/tools"
  spec_orchestration="$REPO_ROOT/home/.config/codex-room/skills/spec-orchestration"
  obsolete_paths=(
    "$overlays_root/review.config.toml"
    "$overlays_root/harness.config.toml"
    "$REPO_ROOT/home/.config/codex-room/paseo.phase2-coexist.candidate.json.template"
    "$REPO_ROOT/home/.config/codex-room/paseo.phase2-hard-cut.candidate.json.template"
    "$REPO_ROOT/home/.local/bin/codex-room-hard-cut"
    "$REPO_ROOT/home/.local/bin/codex-review-apply"
  )
else
  config_template="$HOME/.paseo/config.json"
  overlays_root="$HOME/.config/codex-room/overlays"
  workflow_root="$HOME/.config/codex-room/workflow"
  sync_path="$HOME/.local/bin/codex-room-sync"
  launcher_path="$HOME/.local/bin/codex-room"
  agent_launcher_path="$HOME/.local/bin/agent-room"
  omp_overlay_path="$HOME/.config/codex-room/omp-room.config.yml"
  tools_root="$HOME/.config/codex-room/tools"
  spec_orchestration="$HOME/.config/codex-room/skills/spec-orchestration"
  obsolete_paths=(
    "$overlays_root/review.config.toml"
    "$overlays_root/harness.config.toml"
    "$HOME/.config/codex-room/paseo.phase2-coexist.candidate.json"
    "$HOME/.config/codex-room/paseo.phase2-hard-cut.candidate.json"
    "$HOME/.local/bin/codex-room-hard-cut"
    "$HOME/.local/bin/codex-review-apply"
  )
fi
for name in SKILL.md reference.md questions.md brief-template.md scripts/frontier.py \
  scripts/ticket-field.py scripts/tree-audit.py scripts/worktree-guard.py scripts/run-procs.py; do
  obsolete_paths+=("$spec_orchestration/$name")
done

check "Paseo config exists" test -f "$config_template"
check "Paseo config is valid JSON" jq -e . "$config_template"
check "room sync exists" test -f "$sync_path"
check "room launcher is executable" test -x "$launcher_path"
check "Claude/omp room launcher is executable" test -x "$agent_launcher_path"
check "omp room overlay exists" test -f "$omp_overlay_path"
check "omp room overlay removes native subagents" grep -Eq '^[[:space:]]+maxRecursionDepth: 0$' "$omp_overlay_path"
check "workspace protocol exists" test -f "$workflow_root/WORKSPACE_PROTOCOL.md"
check "Paseo provenance manifest exists" test -f "$REPO_ROOT/paseo/source.toml"
check "implement-spec Room mapping exists" test -f "$workflow_root/IMPLEMENT_SPEC.md"
for tool in tree-audit.py worktree-guard.py run-procs.py; do
  check "room tool $tool is executable" test -x "$tools_root/$tool"
done
check "Lead routes specs to the global implement-spec skill" grep -Fq "~/.agents/skills/implement-spec/SKILL.md" "$overlays_root/lead.config.toml"
check "Lead reads the Room implement-spec mapping" grep -Fq "workflow/IMPLEMENT_SPEC.md" "$overlays_root/lead.config.toml"
check "writable Peers are capped at three" grep -Fq "three at once" "$workflow_root/WORKSPACE_PROTOCOL.md"

for role in supervisor lead peer; do
  check "$role overlay exists" test -f "$overlays_root/$role.config.toml"
done
path_is_absent() {
  [[ ! -e "$1" && ! -L "$1" ]]
}

preserved_obsolete_path() {
  [[ "${CODEX_ROOM_ALLOW_PRESERVED_OBSOLETE:-}" == 1 ]] || return 1
  [[ "$mode" == installed && ( -e "$1" || -L "$1" ) ]] || return 1
  # Legacy installs wrote regular files.  A link or directory is therefore
  # operator-owned/customized material; retain it under the public installer
  # while keeping the default verifier strict for direct maintenance checks.
  if [[ -L "$1" || ! -f "$1" ]]; then
    return 0
  fi
  local digest
  local expected_mode
  case "${1#$HOME/}" in
    .config/codex-room/overlays/review.config.toml|.config/codex-room/overlays/harness.config.toml|.config/codex-room/paseo.phase2-coexist.candidate.json|.config/codex-room/paseo.phase2-hard-cut.candidate.json)
      expected_mode=600 ;;
    .local/bin/codex-room-hard-cut|.local/bin/codex-review-apply)
      expected_mode=700 ;;
    .config/codex-room/workflow/ANTI_PATTERNS.md|.config/codex-room/workflow/SUPERVISOR_NOTEBOOK.md)
      expected_mode=644 ;;
    .config/codex-room/skills/spec-orchestration/*.md)
      expected_mode=644 ;;
    .config/codex-room/skills/spec-orchestration/scripts/*.py)
      expected_mode=755 ;;
    *) return 1 ;;
  esac
  local actual_mode
  actual_mode=$(stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1")
  [[ "$actual_mode" == "$expected_mode" ]] || return 0
  digest=$(sha256_file "$1")
  historical_rendered_digest() {
    local template="$1"
    python3 - "$template" "$HOME" <<'PY'
import hashlib
import pathlib
import sys

template = pathlib.Path(sys.argv[1]).read_bytes()
home = sys.argv[2].encode()
print(hashlib.sha256(template.replace(b"@@HOME@@", home)).hexdigest())
PY
  }
  case "${1#$HOME/}" in
    .config/codex-room/overlays/review.config.toml)
      [[ "$digest" != bd6658ce6fbd53a6904e41752f31493fea77ae76b974cde881dc254b89aa9e94 ]] ;;
    .config/codex-room/overlays/harness.config.toml)
      [[ "$digest" != f963efcd545237153ac33382c12930df97afc50b08712751f442e80c6f502889 ]] ;;
    .config/codex-room/paseo.phase2-coexist.candidate.json)
      [[ "$digest" != "$(historical_rendered_digest "$REPO_ROOT/paseo/legacy/paseo.phase2-coexist.candidate.json.template")" ]] ;;
    .config/codex-room/paseo.phase2-hard-cut.candidate.json)
      [[ "$digest" != "$(historical_rendered_digest "$REPO_ROOT/paseo/legacy/paseo.phase2-hard-cut.candidate.json.template")" ]] ;;
    .local/bin/codex-room-hard-cut)
      [[ "$digest" != 86efcfd46a25940353c889a938a8b901e9cd04e499a93287f7bda0696dbf041a ]] ;;
    .local/bin/codex-review-apply)
      [[ "$digest" != df86d65034f2be7441cabf71319f1b6d9bf1e92c8a6bba72dbb46bc4e99d6262 ]] ;;
    .config/codex-room/workflow/ANTI_PATTERNS.md)
      [[ "$digest" != b25baaf4f632a41fb1761bc8ac7b14258b7afd011a27d2c71833d9b027109972 ]] ;;
    .config/codex-room/workflow/SUPERVISOR_NOTEBOOK.md)
      [[ "$digest" != d644212642909ba20c4960503f89ef74b4897e39cf4096f5c9c1df2c686d430f ]] ;;
    .config/codex-room/skills/spec-orchestration/*)
      ! grep -Fqx "$digest" <<'DIGESTS'
db02670871fd7a8a59bc6d9acfbbb1e2284c6c159792b16308a286b39ca162b3
723e0e0d83cb50913680e7f298b32b27002c2f88b367a9e34a3e9926675f7bda
af6609862fe97acd46379dbe6fcf75b7f32f7f611a9cfe5485891adfae236ab9
399f25233e51dcf60c9fc5ced9f3c4ad606e56c6f5535b2abf332c59ab727577
59f874b00ef3a13355e1be5ef8d6cf52904b78ae73aabd0201ffb9727a26c402
b5c66787efca419b3ebcb48303be70b0bd86a9e64ed9f95f0f5150650a9a63d1
4a55915566396f96c4ade637e1e695725aaad74da0f34997b9c03933dab65321
b60d355e823a55e80b131648a6b8035c4353e43e42efbb47f2613e5f6e566483
418064ff2e7c004c322fc1853b3fbed4094011f2dd57ca108d0841f1917a5a26
5e2447affbbbbc43137d37b7d9a2d2382cb4b6e0ca1d7d5eb17ccd50552b61b5
42083c1bd80fb2a445df29daf513fdc24de9539f59f24a12e71e81b59595b626
2b2d88f3bf24a0f422c69b9331a496fb92e4fef1c4c31e27bbdbdf75775f3dbd
5a6b1e94294ceeaa201f3de6b0ff608fe0ad253922b153fdfb4d02b37cdd2149
DIGESTS
      ;;
    *) return 1 ;;
  esac
}

obsolete_is_inactive() {
  path_is_absent "$1" || preserved_obsolete_path "$1"
}
for obsolete_path in "${obsolete_paths[@]}"; do
  check "obsolete path is inactive: $obsolete_path" obsolete_is_inactive "$obsolete_path"
done

if [[ "$mode" == source ]]; then
  for historical_fixture in \
    "$REPO_ROOT/paseo/legacy/paseo.phase2-coexist.candidate.json.template" \
    "$REPO_ROOT/paseo/legacy/paseo.phase2-hard-cut.candidate.json.template"; do
    check "historical rendered obsolete fixture exists: $historical_fixture" test -f "$historical_fixture"
  done
  for retired_source in \
    "$REPO_ROOT/scripts/bootstrap" \
    "$REPO_ROOT/scripts/session-usage" \
    "$REPO_ROOT/docs/session-usage-benchmark.md" \
    "$REPO_ROOT/docs/specs/2026-08-30-harness-plugin-registration-persistence.md" \
    "$REPO_ROOT/tests/fixtures/session-usage.jsonl" \
    "$workflow_root/ANTI_PATTERNS.md" \
    "$workflow_root/SUPERVISOR_NOTEBOOK.md" \
    "$REPO_ROOT/scripts/workflow-pilot-report" \
    "$REPO_ROOT/docs/workflow-pilot.md" \
    "$REPO_ROOT/docs/better-harness-role.md" \
    "$REPO_ROOT/better-harness/source.toml" \
    "$REPO_ROOT/tests/test_multiple_writers.py" \
    "$REPO_ROOT/tests/fixtures/workflow-pilot.jsonl"; do
    check "retired workflow source is absent: $retired_source" path_is_absent "$retired_source"
  done
fi

rejects_legacy_role() {
  ! "$launcher_path" "$1" >/dev/null 2>&1
}
check "launcher rejects Review role" rejects_legacy_role review
check "launcher rejects Harness role" rejects_legacy_role harness
for runtime in claude omp; do
  check "$runtime launcher rejects Review role" bash -c '! "$1" "$2" review >/dev/null 2>&1' bash "$agent_launcher_path" "$runtime"
done
check "Claude/omp launcher rejects unknown runtime" bash -c '! "$1" codex lead >/dev/null 2>&1' bash "$agent_launcher_path"
check "launcher has one public role route" bash -c '! grep -Fq -- "--resolve-evidence-home" "$1"' bash "$launcher_path"

check "Human authority is explicit" grep -Fq "Human owns product goals" "$workflow_root/WORKSPACE_PROTOCOL.md"
check "Lead acceptance is explicit" grep -Fq "explicitly accepts or rejects" "$workflow_root/WORKSPACE_PROTOCOL.md"
check "parallel work requires ready inputs and separate scopes" grep -Fq "only with verified, accepted inputs and separate write scopes" "$workflow_root/WORKSPACE_PROTOCOL.md"
check "each moving write scope has one owner" grep -Fq "Give every moving write scope one owner" "$workflow_root/WORKSPACE_PROTOCOL.md"
check "Peer challenge signals are explicit" grep -Fq "REOPEN_REQUEST" "$workflow_root/WORKSPACE_PROTOCOL.md"
check "event-driven waiting is explicit" grep -Fq "repeatedly polling unchanged state" "$workflow_root/WORKSPACE_PROTOCOL.md"

for active_contract in \
  "$workflow_root/WORKSPACE_PROTOCOL.md" \
  "$overlays_root/supervisor.config.toml" \
  "$overlays_root/lead.config.toml" \
  "$overlays_root/peer.config.toml"; do
  for forbidden in "PARALLEL_CHECK" "multiple-writer" "OCR Review" "Better Harness" "workflow pilot"; do
    check "active contract omits $forbidden" bash -c '! grep -Fqi -- "$1" "$2"' bash "$forbidden" "$active_contract"
  done
done

room_providers_are_exact() {
  jq -e --arg runtime "$1" '
    [.agents.providers | keys[] | select(startswith($runtime + "-"))] | sort ==
    ([$runtime + "-lead", $runtime + "-peer", $runtime + "-supervisor"])
  ' "$config_template"
}
if [[ "$mode" == source ]]; then
  provider_launcher="@@HOME@@/.local/bin/agent-room"
else
  provider_launcher="$HOME/.local/bin/agent-room"
fi
room_provider_launches_role() {
  jq -e --arg runtime "$1" --arg launcher "$provider_launcher" '
    [("supervisor", "lead", "peer") as $role |
      .agents.providers[$runtime + "-" + $role] |
      .extends == $runtime and .command == [$launcher, $runtime, $role]] | all
  ' "$config_template"
}
for runtime in codex claude omp; do
  check "exactly three derived $runtime providers" room_providers_are_exact "$runtime"
done
for runtime in claude omp; do
  check "$runtime providers launch agent-room roles" room_provider_launches_role "$runtime"
done
check "exact Paseo tool boundary" jq -e -f "$REPO_ROOT/scripts/lib/paseo-tools.jq" "$config_template"

if [[ "$mode" == installed ]]; then
  toml_python="${CODEX_ROOM_TOML_PYTHON:-python3.11}"
  require_command "$toml_python"
  runtime_policy_disabled() {
    "$toml_python" - "$1" <<'PY'
import pathlib
import sys
try:
    import tomllib
except ImportError:
    raise SystemExit("ERROR: runtime verification requires a Python interpreter with tomllib (3.11+)")

try:
    with pathlib.Path(sys.argv[1]).open("rb") as stream:
        config = tomllib.load(stream)
except (OSError, tomllib.TOMLDecodeError) as error:
    raise SystemExit(f"ERROR: cannot read runtime TOML {sys.argv[1]}: {error}")

if config.get("agents", {}).get("enabled") is not False:
    raise SystemExit("ERROR: agents.enabled must be false in the Room runtime")
features = config.get("features", {})
v2 = features.get("multi_agent_v2")
v2_disabled = v2 is False or (isinstance(v2, dict) and v2.get("enabled") is False)
if features.get("multi_agent") is not False or not v2_disabled:
    raise SystemExit("ERROR: features.multi_agent and multi_agent_v2 must be disabled in the Room runtime")
PY
  }
  paseo_checkout="${PASEO_REPO_DIR:-$HOME/projects/supervisors/paseo}"
  paseo_cli_link="${PASEO_CLI_LINK:-$HOME/.local/bin/paseo}"
  expected_paseo_cli="$paseo_checkout/packages/cli/bin/paseo"
  expected_paseo_cli_bundle="$paseo_checkout/packages/cli/dist/index.js"
  expected_paseo_server_bundle="$paseo_checkout/packages/server/dist/scripts/supervisor-entrypoint.js"
  check "Paseo CLI links to stable release" test \
    "$(readlink "$paseo_cli_link" 2>/dev/null || true)" = "$expected_paseo_cli"
  check "Paseo CLI entrypoint is executable" test -x "$expected_paseo_cli"
  check "Paseo CLI bundle exists" test -f "$expected_paseo_cli_bundle"
  check "Paseo CLI bundle is a direct file" test ! -L "$expected_paseo_cli_bundle"
  check "Paseo daemon runner exists" test -f "$expected_paseo_server_bundle"
  check "Paseo daemon runner is a direct file" test ! -L "$expected_paseo_server_bundle"
  paseo_cli_help() {
    (cd "$paseo_checkout" && "./packages/cli/bin/paseo" --help >/dev/null 2>&1)
  }
  check "Paseo CLI --help runs" paseo_cli_help
  expected_paseo_commit=$(awk -F'"' '/^verified_commit = / {print $2}' "$REPO_ROOT/paseo/source.toml")
  expected_paseo_branch=$(awk -F'"' '/^branch = / {print $2; exit}' "$REPO_ROOT/paseo/source.toml")
  expected_paseo_source=$(awk -F'"' '/^url = / {print $2; exit}' "$REPO_ROOT/paseo/source.toml")
  check "Paseo checkout commit" test "$(git -C "$paseo_checkout" rev-parse HEAD 2>/dev/null || true)" = "$expected_paseo_commit"
  check "Paseo checkout branch" test "$(git -C "$paseo_checkout" branch --show-current 2>/dev/null || true)" = "$expected_paseo_branch"
  check "Paseo origin is official source" test "$(git -C "$paseo_checkout" remote get-url origin 2>/dev/null || true)" = "$expected_paseo_source"
  check "Paseo branch tracks origin" test "$(git -C "$paseo_checkout" config --get "branch.$expected_paseo_branch.remote" 2>/dev/null || true)" = origin
  check "Paseo tracking ref" test "$(git -C "$paseo_checkout" config --get "branch.$expected_paseo_branch.merge" 2>/dev/null || true)" = "refs/heads/$expected_paseo_branch"
  expected_paseo_tag=$(awk -F'"' '/^release_tag = / {print $2; exit}' "$REPO_ROOT/paseo/source.toml")
  check "Paseo stable release tag" test "$(git -C "$paseo_checkout" rev-parse "refs/tags/$expected_paseo_tag^{commit}" 2>/dev/null || true)" = "$expected_paseo_commit"
  check "Paseo remote set" test "$(git -C "$paseo_checkout" remote)" = origin
  runtime_root="${CODEX_ROOM_RUNTIME_ROOT:-$HOME/.codex-runtime}"
  for role in supervisor lead peer; do
    runtime="$runtime_root/$role"
    check "$role runtime config" test -f "$runtime/config.toml"
    check "$role native agent catalog" test -f "$runtime/model-catalog.no-native-agents.json"
    if [[ -f "$runtime/model-catalog.no-native-agents.json" ]]; then
      check "$role model agent metadata disabled" jq -e \
        '.models | type == "array" and length > 0 and all(.[]; .multi_agent_version == null)' \
        "$runtime/model-catalog.no-native-agents.json"
    fi
    if [[ -f "$runtime/config.toml" ]]; then
      if policy_result=$(runtime_policy_disabled "$runtime/config.toml" 2>&1); then
        log "OK    $role native-agent policy disabled"
      else
        log "FAIL  $role native-agent policy disabled"
        printf '%s\n' "$policy_result" >&2
        failures=$((failures + 1))
      fi
    fi
    check "$role plugins use canonical symlink" test \
      "$(readlink "$runtime/plugins" 2>/dev/null || true)" = "$HOME/.codex/plugins"
  done
fi

if [[ "$live" == true ]]; then
  paseo_command="${PASEO_COMMAND:-${PASEO_CLI_LINK:-paseo}}"
  require_command "$paseo_command"
  inventory_file=$(mktemp "${TMPDIR:-/tmp}/codex-room-provider-check.XXXXXX")
  if "$paseo_command" provider ls --host 127.0.0.1:6767 --json >"$inventory_file" 2>/dev/null; then
    check "exact live room provider inventory" jq -e '
      [.[].provider | select(test("^(codex|claude|omp)-"))] | sort ==
      ["claude-lead", "claude-peer", "claude-supervisor",
       "codex-lead", "codex-peer", "codex-supervisor",
       "omp-lead", "omp-peer", "omp-supervisor"]
    ' "$inventory_file"
  else
    log "FAIL  live Paseo provider inventory is unreachable"
    failures=$((failures + 1))
  fi
  rm -f "$inventory_file"
fi

[[ "$failures" -eq 0 ]] || die "$failures verification check(s) failed"
log "VERIFY_OK"
